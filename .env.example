# Sao chép file này thành ".env" (hoặc export trực tiếp trong shell) để chạy
# check_aqi.py / dashboard.py ở máy local. KHÔNG commit file ".env" thật lên git.

# API token lấy tại https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# URL Discord Webhook, tạo tại: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxxxx/yyyyy

# Thành phố/trạm AQICN, mặc định "hanoi" nếu không set
AQI_CITY=hanoi
